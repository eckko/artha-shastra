   "07.16.1"
  ],
  "lines_deva": [
   "अनुज्ञात.सन्धि.पण.उद्वेग.करं बलवान् विजिगीषमाणो यतः स्व.भूमिः स्व.ऋतु.वृत्तिश् च स्व.सैन्यानाम्, अदुर्ग.अपसारः शत्रुर्.अपार्ष्णिर् अनासारश् च, ततो यायात्"
  ],
  "lines_iast": [
   "anujñāta.sandhi.paṇa.udvega.karaṃ balavān vijigīṣamāṇo yataḥ sva.bhūmiḥ sva.ṛtu.vṛttiś ca sva.sainyānām, adurga.apasāraḥ śatrur.apārṣṇir anāsāraś ca, tato yāyāt"
  ],
  "book_split": [
   ""
