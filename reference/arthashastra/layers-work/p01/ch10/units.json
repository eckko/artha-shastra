  "lines_deva": [
   "तत्र धर्म.उपधा.शुद्धान् धर्म.स्थीय.कण्टक.शोधनेषु कर्मसु स्थापयेत्, अर्थ.उपधा.शुद्धान् समाहर्तृ.सम्निधातृ.निचय.कर्मसु, काम.उपधा शुद्धान् बाह्य.आभ्यन्तर.विहार.रक्षासु, भय.उपधा.शुद्धान् आसन्न.कार्येषु राज्ञः"
  ],
  "lines_iast": [
   "tatra dharma.upadhā.śuddhān dharma.sthīya.kaṇṭaka.śodhaneṣu karmasu sthāpayet, artha.upadhā.śuddhān samāhartṛ.samnidhātṛ.nicaya.karmasu, kāma.upadhā śuddhān bāhya.ābhyantara.vihāra.rakṣāsu, bhaya.upadhā.śuddhān āsanna.kāryeṣu rājñaḥ"
  ],
