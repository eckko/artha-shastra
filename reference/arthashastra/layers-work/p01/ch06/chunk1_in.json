  ],
  "lines_iast": [
   "yathā dāṇḍakyo nāma bhojaḥ kāmād brāhmaṇa.kanyām abhimanyamānaḥ sa-bandhu.rāṣṭro vinanāśa, karālaś ca vaidehaḥ"
  ],
