  ],
  "lines_iast": [
   "karṇa.tvag.akṣi.jihvā.ghrāṇa.indriyāṇāṃ śabda.sparśa.rūpa.rasa.gandheṣv avipratipattir indriya.jayaḥ, śāstra.anuṣṭhānaṃ vā"
  ],
