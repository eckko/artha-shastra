  ],
  "lines_iast": [
   "jātiṃ kulaṃ sthāna.vayaḥ.śrutāni karma.ṛddhi.śīlāny atha deśa.kālau",
   "yauna.anubandhaṃ ca samīkṣya kārye lekhaṃ vidadhyāt puruṣa.anurūpam"
