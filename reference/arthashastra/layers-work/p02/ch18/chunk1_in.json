  "lines_deva": [
   "आयुध.अगार.अध्यक्षः साङ्ग्रामिकं दौर्गकर्मिकं पर.पुर.अभिघातिकं च यन्त्रम् आयुधम् आवरणम् उपकरणं च तज्.जात.कारु.शिल्पिभिः कृत.कर्म.प्रमाण.काल.वेतन.फल.निष्पत्तिभिः कारयेत्, स्व.भूमिषु च स्थापयेत्"
  ],
  "lines_iast": [
   "āyudha.agāra.adhyakṣaḥ sāṅgrāmikaṃ daurgakarmikaṃ para.pura.abhighātikaṃ ca yantram āyudham āvaraṇam upakaraṇaṃ ca taj.jāta.kāru.śilpibhiḥ kṛta.karma.pramāṇa.kāla.vetana.phala.niṣpattibhiḥ kārayet, sva.bhūmiṣu ca sthāpayet"
  ],
