  ],
  "lines_iast": [
   "tasya-upari-ubhayato.niṣedhaṃ sa-pragrīvam aiṣṭakaṃ bhāṇḍa.vāhinī.parikṣiptaṃ kośa.gṛhaṃ kārayet, prāsādaṃ vā"
  ],
