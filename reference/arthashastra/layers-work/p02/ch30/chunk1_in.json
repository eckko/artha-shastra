  "lines_deva": [
   "अश्व.अध्यक्षः पण्य.आगारिकं क्रय.उपागतम् आहव.लब्धम् आजातं साहाय्य.आगतकं पण.स्थितं यावत्.कालिकं वा-अश्व.पर्यग्रं कुल.वयो.वर्ण.चिह्न.वर्ग.आगमैर् लेखयेत्"
  ],
  "lines_iast": [
   "aśva.adhyakṣaḥ paṇya.āgārikaṃ kraya.upāgatam āhava.labdham ājātaṃ sāhāyya.āgatakaṃ paṇa.sthitaṃ yāvat.kālikaṃ vā-aśva.paryagraṃ kula.vayo.varṇa.cihna.varga.āgamair lekhayet"
  ],
