  "lines_deva": [
   "महा.पशु.मनुष्य.क्षेत्र.गृह.हिरण्य.सुवर्ण.सूक्ष्म.वस्त्र.आदीनां स्थूलक.द्रव्याणां द्विशत.अवरः पञ्च.शत.परो मध्यमः साहस.दण्डः"
  ],
  "lines_iast": [
   "mahā.paśu.manuṣya.kṣetra.gṛha.hiraṇya.suvarṇa.sūkṣma.vastra.ādīnāṃ sthūlaka.dravyāṇāṃ dviśata.avaraḥ pañca.śata.paro madhyamaḥ sāhasa.daṇḍaḥ"
  ],
