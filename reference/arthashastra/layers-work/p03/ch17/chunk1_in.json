  "lines_deva": [
   "प्रजानां दोष.बाहुल्याद् राज्ञां वा भाव.दोषतः",
   "रूप.व्याज्याव् अधर्मिष्ठे धर्म्या तु प्रकृतिः स्मृता"
  ],
  "lines_iast": [
   "prajānāṃ doṣa.bāhulyād rājñāṃ vā bhāva.doṣataḥ",
   "rūpa.vyājyāv adharmiṣṭhe dharmyā tu prakṛtiḥ smṛtā"
