  ],
  "lines_iast": [
   "kāla.āyasa.kāṣṭha.rajju.dravya.kṣudra.paśu.paṭa.ādīnāṃ sthūlaka.dravyāṇāṃ caturviṃśati.paṇa.avaro 'ṣṭa.catvāriṃśat.paṇa.paro daṇḍaḥ"
