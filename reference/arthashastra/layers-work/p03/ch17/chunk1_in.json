  ],
  "lines_deva": [
   "स्त्रियं पुरुषं वा-अभिषह्य बध्नतो बन्धयतो बन्धं वा मोक्षयतः पञ्च.शत.अवरः सहस्र.पर उत्तमः साहस.दण्डः ।\" इत्य् आचार्याः"
  ],
  "lines_iast": [
   "striyaṃ puruṣaṃ vā-abhiṣahya badhnato bandhayato bandhaṃ vā mokṣayataḥ pañca.śata.avaraḥ sahasra.para uttamaḥ sāhasa.daṇḍaḥ |\" ity ācāryāḥ"
  ],
