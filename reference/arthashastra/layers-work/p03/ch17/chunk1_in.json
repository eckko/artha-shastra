  "lines_deva": [
   "यः \"एतावद्द् हिरण्यं दास्यामि\" इति प्रमाणम् उद्दिश्य कारयति स यथा.उक्तं हिरण्यं दण्डं च दद्यात्\" इति बार्हस्पत्याः"
  ],
  "lines_iast": [
   "yaḥ \"etāvadd hiraṇyaṃ dāsyāmi\" iti pramāṇam uddiśya kārayati sa yathā.uktaṃ hiraṇyaṃ daṇḍaṃ ca dadyāt\" iti bārhaspatyāḥ"
  ],
