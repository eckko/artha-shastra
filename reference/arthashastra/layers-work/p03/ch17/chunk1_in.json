  "lines_deva": [
   "\"पुष्प.फल.शाक.मूल.कन्द.पक्व.अन्न.चर्म.वेणु.मृद्.भाण्ड.- आदीनां क्षुद्रक.द्रव्याणां द्वाद्श.पण.अवरश् चतुर्विंशति.पण.परो दण्डः"
  ],
  "lines_iast": [
   "\"puṣpa.phala.śāka.mūla.kanda.pakva.anna.carma.veṇu.mṛd.bhāṇḍa.- ādīnāṃ kṣudraka.dravyāṇāṃ dvādśa.paṇa.avaraś caturviṃśati.paṇa.paro daṇḍaḥ"
  ],
