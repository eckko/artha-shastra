  "lines_deva": [
   "एक.स्त्री.पुत्राणां ज्येष्ठ.अंशः - ब्राह्मणानाम् अजाः, क्षत्रियाणाम् अश्वाः, वैश्यानां गावः, शूद्राणाम् अवयः"
  ],
  "lines_iast": [
   "eka.strī.putrāṇāṃ jyeṣṭha.aṃśaḥ - brāhmaṇānām ajāḥ, kṣatriyāṇām aśvāḥ, vaiśyānāṃ gāvaḥ, śūdrāṇām avayaḥ"
  ],
